graphify-out/

# ---------------------------------------------------------------------------
# Project specific (pysandboxes)
# ---------------------------------------------------------------------------
.py-sandboxes
.local.py-sandboxes*
.pysandboxes
# Written in the working directory by qemu.show_boot_console=true
.pysandbox-qemu-console.log
netfilter*.net
run.sh
# Write probe of tst_usage: only ever created if a guard fails to deny it
/denied-write.probe
tmp*/
etudes/
tst_wasm/
PPR*
# Ignore the contents, not the directory: git does not descend into an ignored
# directory, so the !_tasks/lessons.md exception below would never be reached.
/_tasks/*

# ---------------------------------------------------------------------------
# Read-only stubs (0 byte, mode 444) dropped in the working directory by the
# Claude Code Bash sandbox on every sandboxed command, to hold a read-only bind
# mount over each path. They are not produced by the test suite: the full
# integration run over all six OS-sandbox providers creates none of them, while
# a bare `true` inside the sandbox creates all nine.
# ---------------------------------------------------------------------------
/.bashrc
/.zshrc
/.profile
/.bash_profile
/.zprofile
/.gitconfig
/.gitmodules
/.ripgreprc
/.mcp.json
**/.tgrep/
/openwiki/
/audits/
/lat.md/
/tmp/

# Written at build time by hatch-vcs, from the git tag
/pysandboxes/_version.py

# ---------------------------------------------------------------------------
# research/: the markdown sources are versioned, the LaTeX chain and its
# output are not. `make -C research` rebuilds them from research.md.
# ---------------------------------------------------------------------------
/research/*
!/research/*.md

# ---------------------------------------------------------------------------
# Per-agent local files. AGENTS.md is the versioned guide, and the tools read
# it directly; .claudeignore is personal tooling, kept on disk only.
# ---------------------------------------------------------------------------
/.claudeignore

# ---------------------------------------------------------------------------
# Per-session working notes: local to the clone, never versioned
# ---------------------------------------------------------------------------
_tasks/*
# lessons.md is the one versioned exception: it carries repo-level rules, not
# session workspace. Must stay last, after every _tasks pattern above.
!_tasks/lessons.md
