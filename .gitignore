#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# PyBuilder
.pybuilder/
target/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Makefile stamps (make dist, make build-image-*)
.make-*

