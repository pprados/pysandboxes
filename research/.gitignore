# LaTeX build tree: everything here is regenerated by `make` from the sources
# next to it (research.md -> .tex -> .pdf), so versioning it would add a few MB
# of churn per rebuild for nothing.
build/

# The arXiv submission bundle, repacked by `make arxiv` from the same sources.
*-arxiv.tar.gz

# Local assistant configuration, not part of the paper.
.claude/
