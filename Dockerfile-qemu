# qemu provider: base + QEMU and VM image for this Python version, and iptables: the guest's /lib is overlaid by this
# image's, so the guest's iptables-restore, which applies the network filter, loads its libxtables from here.
# Build: make build-image-qemu  =>  python-sb-qemu:$(PYTHON_VERSION), python-sb-qemu:latest
ARG PYTHON_VERSION=3.11
FROM python-sb:${PYTHON_VERSION}

ENV PYSANDBOXES_VM_IMAGES_DIR=/var/lib/pysandboxes/vm-images
# QEMU_PKG passed from Makefile (qemu-system-x86 or qemu-system-aarch64 per host arch)
ARG QEMU_PKG=qemu-system-x86
RUN set -eux \
    && apt-get update \
    && apt-get install -y --no-install-recommends "$QEMU_PKG" qemu-utils genisoimage iptables \
    && mkdir -p "${PYSANDBOXES_VM_IMAGES_DIR}" \
    && python -m pysandboxes.remote.qemu_fetch_image \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# The guest's iptables-restore must meet the libxtables and the extensions it was built with: a 24.04 guest (1.8.10) or
# a 23.04 guest (1.8.7) crashes (free(): invalid pointer) on the 1.8.11 of this Debian base. A 25.04 guest has the
# 1.8.11 already. The release of the guest names the Ubuntu series whose libraries are copied over the base's, with the
# tools that load them: the base's own iptables-restore would miss symbols of an older libxtables.
RUN set -eux \
    && release="$(ls "${PYSANDBOXES_VM_IMAGES_DIR}" | sed -n 's/^ubuntu-\([0-9.]*\)-.*/\1/p' | head -1)" \
    && case "$release" in 24.04) series=noble; mirror=http://archive.ubuntu.com/ubuntu ;; \
        23.04) series=lunar; mirror=http://old-releases.ubuntu.com/ubuntu ;; *) series= ;; esac \
    && if [ -n "$series" ]; then \
        [ "$(dpkg --print-architecture)" = amd64 ] || [ "$series" = lunar ] || mirror=http://ports.ubuntu.com/ubuntu-ports; \
        apt-get update; \
        apt-get install -y --no-install-recommends ubuntu-keyring; \
        mkdir -p /tmp/ub/lists /tmp/ub/debs /tmp/ub/x; \
        echo "deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] $mirror $series main" > /tmp/ub/sources.list; \
        apt_ub="apt-get -o Dir::Etc::sourcelist=/tmp/ub/sources.list -o Dir::Etc::sourceparts=/dev/null -o Dir::State::lists=/tmp/ub/lists"; \
        $apt_ub update; \
        cd /tmp/ub/debs; \
        $apt_ub download iptables/$series libxtables12/$series libip4tc2/$series libip6tc2/$series libnftnl11/$series libmnl0/$series; \
        for deb in *.deb; do dpkg-deb -x "$deb" /tmp/ub/x; done; \
        for lib in /tmp/ub/x/usr/lib/*-linux-gnu; do cp -a "$lib/." "/usr/lib/$(basename "$lib")/"; done; \
        for bin in sbin bin; do [ -d "/tmp/ub/x/usr/$bin" ] && cp -a "/tmp/ub/x/usr/$bin/." "/usr/$bin/"; done; \
        rm -rf /tmp/ub; \
        apt-get purge -y ubuntu-keyring; \
        apt-get autoremove -y; \
        rm -rf /var/lib/apt/lists/*; \
    fi

CMD ["python-sb"]
