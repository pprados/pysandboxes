py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

env=HOME=${HOME}
env=TERM=${TERM}
env=LLM_TOKEN=${LLM_TOKEN}

# ⚠ Dangerous!
python-import=atexit, importlib, inspect

# Standard Python
python-import=__future__, _decimal, _hashlib, _io, _multibytecodec, abc, array, ast
python-import=base64, binascii, calendar, codecs, collections, colorsys
python-import=configparser, contextlib, copy, dataclasses, datetime, decimal, email
python-import=encodings, enum, errno, fnmatch, fractions, functools, getpass
python-import=hashlib, hmac, html, http, io, ipaddress, itertools, json, linecache
python-import=logging, marshal, math, mimetypes, netrc, numbers, operator, os
python-import=pathlib, queue, random, re, reprlib, runpy, select, socket, ssl
python-import=stringprep, struct, tempfile, termios, textwrap, threading, time
python-import=traceback, types, typing, unicodedata, urllib, weakref, zipfile, zlib

# External modules (Are you sure about the origin?)
python-import=attr
python-import=certifi
python-import=charset_normalizer
python-import=idna
python-import=pygments
python-import=requests
python-import=rich
python-import=tests
python-import=urllib3

bind=./tmp,./tmp
ro-bind=/etc,/etc

net=ALLOW|TCP|ip6-localhost|9999,0|IN
net=ALLOW|TCP|localhost|9999|IN
net=ALLOW|TCP|www.google.com|80|OUT
net=ALLOW|UDP|ip6-localhost|12345|OUT
net=ALLOW|UDP|localhost|12345|IN
net=ALLOW|UDP|localhost|12346,12345|OUT
