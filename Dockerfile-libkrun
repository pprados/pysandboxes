# libkrun provider: base + libkrun and libkrunfw, built from source, and the tools of the network filter.
# Build: make build-image-libkrun  =>  python-sb-libkrun:$(PYTHON_VERSION), python-sb-libkrun:latest
#
# Run it with the KVM device: docker run --device /dev/kvm ... (and --device /dev/net/tun for a profile with a net= rule).
#
# libkrun is built from its main branch (2.0.0-dev) at a pinned commit: the provider uses the C API generated by ffier,
# which no release has yet. Move to the v2 release when it is published, and replace LIBKRUN_REF by its tag.
ARG PYTHON_VERSION=3.11

FROM python-sb:${PYTHON_VERSION} AS build

ARG LIBKRUNFW_REF=v5.5.0
ARG LIBKRUN_REF=2fc56b5b6fcef00fc327768c8bbd692cf90b03df
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH

# Everything here stays in this stage: the toolchain, the sources and the kernel tarball never reach the final image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    bc \
    bison \
    ca-certificates \
    curl \
    flex \
    git \
    libclang-dev \
    libelf-dev \
    musl-tools \
    xz-utils && \
    pip install --no-cache-dir pyelftools && \
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --component rustfmt --default-toolchain stable \
    --target "$(uname -m)-unknown-linux-musl"

# libkrunfw: the guest kernel, compiled from the Linux sources its Makefile downloads.
RUN git clone https://github.com/libkrun/libkrunfw /src/libkrunfw && \
    git -C /src/libkrunfw checkout "${LIBKRUNFW_REF}" && \
    make -C /src/libkrunfw -j"$(nproc)" && \
    make -C /src/libkrunfw DESTDIR=/out install

# libkrun: the VMM, with the network and block devices and the C API.
RUN git clone https://github.com/libkrun/libkrun /src/libkrun && \
    git -C /src/libkrun checkout "${LIBKRUN_REF}" && \
    make -C /src/libkrun -j"$(nproc)" BLK=1 NET=1 && \
    make -C /src/libkrun BLK=1 NET=1 DESTDIR=/out install


FROM python-sb:${PYTHON_VERSION}

# The guest runs util-linux tools (setpriv, pivot_root, mount) through the shared root; the network filter needs the
# others, and passt is the user-space stack the guest talks to.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    iproute2 \
    iptables \
    passt \
    slirp4netns \
    util-linux && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /out/usr/local/ /usr/local/
RUN echo /usr/local/lib64 > /etc/ld.so.conf.d/libkrun.conf && ldconfig

CMD ["python-sb"]
