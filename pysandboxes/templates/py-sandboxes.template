# PySandboxes Configuration File
# ===============================
# This configuration defines security rules for Python code execution in a sandboxed
# environment. It follows a default-deny security model where all access is prohibited
# unless explicitly allowed through rules.

#######################################################################################
# CONFIGURATION COMPOSITION
# ==========================
# You can include additional configuration files for better organization.
# Name without '/' may be in the same directory.
# Missing files are silently ignored.

# Uncomment to accept local rules. The path is resolved from the current directory, so
# whatever directory the program is launched from can then add rules of its own.
#include "./.local.py-sandboxes"  # May be add to .gitignore
include "~/.config/py-sandboxes/user-py-sandboxes.profile"  # For all project for user
include "/etc/py-sandboxes/global-py-sandboxes.profile"  # For all the node

#######################################################################################
# ENVIRONMENT VARIABLES
# =====================
# By default, sandbox processes have NO access to environment variables.
# Use env rules to explicitly whitelist required variables.
#
# Syntax patterns:
# - env=VAR=value                    Set fixed value
# - env=VAR=${HOST_VAR}              Copy from host environment
# - env=VAR=${HOST_VAR:-default}     Copy with fallback default
# - env=PATTERN_*=${PATTERN_*}       Pattern matching for multiple vars
# - unenv=VAR                        Explicitly remove variable
#
# Security considerations:
# - Never expose secrets unnecessarily: review API keys, tokens, passwords
# - Use specific variable names rather than wildcards when possible
# - Consider using fixed values instead of copying sensitive host variables

# Common safe variables:
#env=USER=sandbox
# The temporary directory, in the order tempfile.gettempdir() consults: TMPDIR is
# the POSIX name, TEMP and TMP are Windows conventions, and none of the three is
# set on a stock Linux shell -- hence the final literal.
#env=TMPDIR=${TMPDIR:-${TEMP:-${TMP:-/tmp}}}

# API access (high security risk):
#env=*_API_KEY=${*_API_KEY}
#env=*_BASE_URL=${*_BASE_URL}
#unenv=OPENAI_API_KEY

# Generated rules from learning mode:
# <learning_guard_envs>

# </learning_guard_envs>

#######################################################################################
# FILE SYSTEM ACCESS
# ===================
# By default, all file system access is denied. Use explicit rules to grant access.
#
# Rules:
# - ignore=<glob pattern>   Block access to files matching glob pattern
# - expose-rw=<source>      Expose host directory (read-write)
# - expose-ro=<source>      Expose host directory (read-only)
#
# Security guidelines:
# - Always use most restrictive access possible (prefer expose-ro over expose-rw)
# - Use specific paths rather than broad patterns when possible
# - Be careful with ignore patterns that might affect expected directories
#
# Paths written by learning mode: ${VAR} under a known tool directory (VIRTUAL_ENV,
# HF_HOME...), ./... under the working directory, ~/... under the home directory,
# ${TMPDIR:-/tmp}/... under the temporary one, absolute elsewhere. A
# directory above the working directory therefore comes out as ~/... or absolute, which
# only holds on this machine: for a profile shared through the repository, write it by
# hand relative to the working directory (e.g. expose-ro=../..), and learning then adds
# nothing for it.
#
# WARNING: ignore=.* blocks access to .venv, .git, and other hidden directories

# Block sensitive files by default:
#ignore=.env
#ignore=*.log

# Example directory mounts:
#expose-ro=/usr             # Read-only system libraries
#expose-ro=.                # Read-only project directory
#expose-rw=./data           # Read-write data directory
#expose-rw=/tmp             # Temporary files

# Generated rules from learning mode:
# <learning_guard_files>

# </learning_guard_files>

#######################################################################################
# NETWORK ACCESS CONTROL
# =======================
# By default, ALL network connections are denied. Use explicit rules to allow access.
#
# Rule format: net=<ACTION>|<PROTOCOL>|<NETWORK>|<PORTS>|<DIRECTION>
# - ACTION: ALLOW or DENY
# - PROTOCOL: tcp, udp, or * (any)
# - NETWORK: IP/CIDR, hostname, or * (any)
# - PORTS: port number, range (80-443), list (80,443), or * (any)
# - DIRECTION: IN (server), OUT (client), or * (both)
#
# Security guidelines:
# - Use most restrictive rules possible
# - Prefer specific ports over wildcards
# - Consider blocking internal networks to prevent lateral movement
# - Review rules regularly and remove unused access
#
# If you use a hostname in a rule, read 'wiki/dns.md' to fully understand the limitations of this approach.

# Common outbound web access:
#net=ALLOW|tcp|0.0.0.0/0|443|OUT         # HTTPS to anywhere
#net=ALLOW|tcp|0.0.0.0/0|80|OUT          # HTTP to anywhere

# Local server binding:
#net=ALLOW|tcp|0.0.0.0/0|${PORT:-8000}|IN    # Accept connections on port

# Block internal networks (recommended for production):
#net=DENY|*|10.0.0.0/8|*|OUT             # Private Class A
#net=DENY|*|172.16.0.0/12|*|OUT          # Private Class B
#net=DENY|*|192.168.0.0/16|*|OUT         # Private Class C
#net=DENY|*|169.254.0.0/16|*|OUT         # Link-local
#net=DENY|*|127.0.0.0/8|*|OUT            # Loopback
#net=DENY|*|fc00::/7|*|OUT               # IPv6 ULA
#net=DENY|*|fe80::/10|*|OUT              # IPv6 Link-local
# TODO: /etc/firejail/nolocal.net

# Generated rules from learning mode:
# <learning_guard_socket>

# </learning_guard_socket>

#######################################################################################
# PYTHON IMPORTS CONTROL
# =======================
# By default, all Python imports are denied. Use import rules to allow access.
#
# Syntax:
# - python-import=module1,module2      Allow only specific modules
# - python-import=*                    Allow all imports
#
# Security considerations:
# - Restrict dangerous modules: subprocess, os, sys, ctypes, importlib
# - Allow only necessary libraries for your application
# - Consider using virtual environments with minimal packages
#
# Examples:
#python-import=json,requests,pandas     # Allow only these modules
#python-import=*                        # Allow all imports

# Generated rules from learning mode:
# <learning_guard_import>

# </learning_guard_import>

#######################################################################################
# PYTHON API CONTROL
# ===================
# Sensitive function calls. Everything in the registry is denied by
# default, whatever python-import= allows: an import right is not a
# call right.
# - python-api=ALLOW:<category>   Allow a whole category
# - python-api=ALLOW:<function>   Allow one function, e.g. os.system
# - python-api=DENY:<target>      Deny; a function rule beats its
#                                 category, whatever the line order
# - python-api=ALLOW:*            Allow everything (disables the layer)
# Categories: process-exec, process-control, privileges, threads,
# native, introspection.
# Note: the native and introspection categories are detection and
# friction, not a barrier. Sandboxed code can undo Python-level patches
# (see wiki/weaknesses.md); the OS provider is the real barrier.
#
# One call can cross SEVERAL guarded doors in series, because some of
# these functions delegate to others in the registry:
#   subprocess.getoutput -> getstatusoutput -> check_output -> run
#                        -> Popen -> os.posix_spawn
#   pty.spawn -> pty.fork -> os.fork / os.forkpty / os.setsid
#   threading.Thread.start -> threading._start_joinable_thread
# Allowing the outer name alone is then refused on the inner one. Each
# refusal names the door it stopped at, so iterating converges; a
# category covers a whole chain in one line, which is why the category
# form is usually the right one for process-exec.
#
# To generate these rules from real behaviour, run the application once
# in learning mode: the lines land in the block below. Review them
# before keeping them. httpx and anyio create threads, so ALLOW:threads
# is common and legitimate; an ALLOW:process-exec deserves a hard look.
# <learning_guard_api>

# </learning_guard_api>

#######################################################################################
# DYNAMICALLY EVALUATED CODE (eval-*)
# ===================================
# eval(), exec() and compile() run a string the program built at runtime, which
# is exactly the shape of a model's answer. Without a single eval-* key the
# three are refused; with at least one, the source is parsed, checked against
# the sub-language these keys describe, and rewritten so the remaining risks
# are enforced while it runs.
#
# Deny-all as everywhere else: `1 + 1` needs eval-syntax=arith, `len(x)` needs
# eval-call=len, `"a".split()` needs eval-attribute=split. A calculator tool
# handling model output wants:
#
#   eval-namespace=closed
#   eval-syntax=arith, compare
#   eval-timeout=2s
#
# The escape hatch, for code that must keep the old unguarded behaviour, is
# python-api=ALLOW:dynamic-code -- and it is exactly as wide as it sounds.
# For more information, read wiki/eval.md.
# <learning_guard_eval>

# </learning_guard_eval>

# <learning_remote_result>
# </learning_remote_result>


#######################################################################################
# PYTHON SANDBOX ACTIVATION
# ==========================
# Controls whether Python-level security guards are active.
# Set to false to disable Python API patching while keeping OS-level sandboxing.

py-sandbox=true

#######################################################################################
# OS-LEVEL SANDBOX PROVIDERS
# ===========================
# Python-level sandboxing alone cannot prevent all escapes (native code, syscalls).
# OS-level sandboxing provides additional isolation through system namespaces.
#
# Available providers:
# - subprocess: Isolates code in separate Python process (default, safest)
# - firejail, unshare, bwrap, qemu, etc: Advanced Linux sandboxing with syscall filtering,
#   network isolation
# - none: Disables @sandbox decorator (for testing/debugging only)
#
# Note: Some providers may not work in containers without additional privileges.

os-sandbox=${OS_SANDBOX:-subprocess}

#######################################################################################
# TRANSPORT RESULT GUARD
# ======================
# The parent deserializes what the sandboxed child returns over the local SSE
# transport. Because a returned object's reconstruction can run arbitrary code in
# the parent (outside the sandbox), that channel is filtered by a restricted
# unpickler. On the result channel the guard is a denylist of dangerous gadgets
# (fail-open): it lets legitimate return values through and refuses obvious
# escapes. Set to false only if a legitimate return value is wrongly rejected.
#
# Disabling this affects ONLY the result denylist. The opcode prescan, the
# anti-DoS budgets, and the exception-channel guard stay active regardless.
# See wiki/transport-unpickle-guard.md.

remote-result-guard=true

#######################################################################################
# LEARNING MODE LOCK
# ==================
# Every --key=value given to python-sb is a rule that takes precedence over this file,
# and --learn allows everything while recording it. Once this file is reviewed,
# uncomment the line below: the configuration is then refused when the learning mode
# is requested (--learn, learn=<file>, or a missing rule file), when python-sb
# receives a rule on its command line, and when the code passes one to sandboxes()
# or run(). See wiki/configuration.md.

# learn=false

#######################################################################################
# OS PROVIDER PARAMETERS (os-sandbox=…)
# ======================================
# Lines below apply only when os-sandbox matches that provider. Syntax is always
# <provider>.<key>=<value>; the runtime stores keys without the "<provider>." prefix.
# See wiki/qemu.md, wiki/bwrap.md, wiki/unshare.md, wiki/firejail.md, etc.

#######################################################################################
# QEMU (os-sandbox=qemu)
# ======================
#
# qemu.use_kvm — Hardware acceleration
#   true (default): pass -enable-kvm when /dev/kvm is usable; otherwise QEMU falls back
#   to TCG (slower, unprivileged).
#   false: never request KVM. In Docker/Podman, mount --device /dev/kvm when you want KVM.
#
# qemu.memory — Guest RAM (QEMU -m)
#   Default: 2048 (MiB). Use a non-negative integer with an optional single suffix
#   k/M/G/T/P/E (e.g. 512M, 2G). Forms like 2GB are invalid for QEMU and fall back to default.
#   Raise for heavier workloads.
#
# qemu.show_boot_console — VM serial on the host + NoCloud verbosity + guest main_sandbox traces
#   false (default): host output is filtered to Python between guest sentinels (boot hidden);
#   NoCloud user-data stays minimal (no cloud-init debug block, no bash -x on bootstrap);
#   no [PYSANDBOX_DIAG] breadcrumbs or faulthandler in the guest main_sandbox.
#   true: full QEMU console (boot, cloud-init, bootstrap) on the host; tee to
#   .pysandbox-qemu-console.log; verbose cloud-init and set -x on the guest bootstrap script;
#   in the VM, stderr [PYSANDBOX_DIAG] lines and faulthandler after main() starts.
#
# qemu.start_timeout — Seconds the daemon gets to answer, VM boot included
#   The default follows the acceleration in use: 90 with KVM (a whole run takes about
#   22s), 180 when QEMU runs emulated (the same guest answers at ~125s). A container
#   without /dev/kvm needs nothing here; set the key only to override that. The guest is
#   pinged until this deadline and no other limit applies, so there is nothing else to
#   raise. Past it the start fails and the VM is killed, not left behind.
#
# qemu.virtfs — Staging exec trees before virtio-9p (nested containers)
#   auto (default): enable staging only when the host looks like a container (/.dockerenv,
#   /.containerenv, or "container" in the environment) to avoid SIGSEGV on overlay+9p mmap.
#   on / off: force staging on or off. Legacy alias: qemu.virtfs_stage (same values).
#
# qemu.virtfs_security_model — 9p security_model for non-staged mounts
#   Default: mapped-xattr. Staged trees use "none" automatically for reliable .so mmap.

# qemu.use_kvm=true
# qemu.memory=2G
# qemu.show_boot_console=false
# qemu.start_timeout=90
# qemu.virtfs=auto

#######################################################################################
# Bubblewrap (os-sandbox=bwrap)
# ==============================
# Base command is built from pysandboxes/templates/bwrap.template, then PySandboxes adds
# binds, env --setenv, and network mode. Extra options: man bwrap(1), wiki/bwrap.md.
#
# bwrap.share-net — Keep host (or container) network
#   By default the sandbox gets its own network namespace: loopback only without socket
#   rules, slirp4netns + iptables with them. If set to a truthy value (e.g. yes): share
#   the host network stack instead. Use when slirp4netns is unavailable.
#
# bwrap.unshare-net — Disable network filtering / isolated netns
#   no, 0, or false: same effect as forcing shared network—no --unshare-net for filtering.
#
# Any other bwrap.<option>=<value> is appended to bwrap as --<option>=<value> (or
# --<option> if the value is empty). Keys share-net and unshare-net are interpreted only
# by PySandboxes and are not passed as duplicate bwrap flags.

# bwrap.share-net=yes
# bwrap.hostname=my-sandbox

# See https://man.archlinux.org/man/extra/bubblewrap/bwrap.1.en
# bwrap.<param>=<value>

#######################################################################################
# Firejail (os-sandbox=firejail)
# ===============================
# Not supported inside Docker/Podman/Kubernetes images for this project; use bwrap, unshare,
# or qemu there. Base flags come from pysandboxes/templates/firejail.template (and env
# substitution e.g. FIREJAIL_RELIMIT, NICE). man firejail(1), wiki/firejail.md.
#
# Only these profile lines are parsed into Firejail flags. Any other firejail.* line is
# ignored by the provider parser—extend firejail.template or env for more Firejail options:
#
# firejail.net — Network bridge for the sandbox (host reachability often needs a bridge).
#   Example: firejail.net=docker0. If unset with socket rules, the daemon may pick a default;
#   if unset without socket rules, the sandbox gets --net=none (loopback only).
#
# firejail.seccomp — Path to a seccomp list file (passed as --seccomp=…).
# firejail.seccomp.keep — Allowed syscalls (comma-separated) as --seccomp.keep=…
# firejail.seccomp.block — Blocked syscalls as --seccomp.block=…
#
# Socket rules require restricted-network no in /etc/firejail/firejail.config for netfilter
# setup. Without the line the sandbox refuses to start; with an explicit 'restricted-network
# yes' it starts with a warning on the host network, socket rules enforced by Python only;
# see wiki/firejail.md.

# firejail.net=docker0
# firejail.seccomp.keep=read,write,exit

# See https://man7.org/linux/man-pages/man1/firejail.1.html
# firejail.<param>=<value>

#######################################################################################
# Unshare (os-sandbox=unshare)
# ============================
# Launches unshare with flags from pysandboxes/templates/unshare.template, then each
# unshare.<key>=<value> as --key=value (or --key if empty). Requires slirp4netns and
# iptables; kernel.unprivileged_userns_clone=1 on many systems. man unshare(1), wiki/unshare.md.
#
# Typical use: add or override unshare(1) long options the template does not set. The
# template already enables --net, --user, -r, --mount, --propagation private, --pid, --fork,
# --kill-child.

# unshare.<param>=<value>

#######################################################################################
# Subprocess / none (os-sandbox=subprocess | os-sandbox=none)
# ============================================================
# No provider-specific profile keys (no subprocess.* / none.*). Configure env, file, net,
# and import rules only; subprocess is the default isolated Python process provider.
