#######################################################################################
# In a sandbox, it is crucial to prohibit access to certain file patterns
# that contain confidential data (e.g., `.*`). Additionally, it is important to
# limit write access to specific directories or to mount a restricted number
# of directories that are accessible within the sandbox.
#
# The syntax `ignore=<glob_pattern>` allows excluding certain files when using
# Python file APIs. The syntax `bind=<src_dir>,<target_dir>` maps a directory outside
# the sandbox to a directory visible inside the sandbox (which must exist).
# Additionally, `ro-bind` does the same but limits access to the sandbox as read-only.
#
# Warning 'ignore .*' rule exclude the '.venv' directory ! Use another name or
# location for the virtualenv.
#
ignore=.env
ignore=*.log

# Some exemples
#bind=/,/  # Accept all file access
#ro-bind=/,/  # Accept to read all file (add rules to write in somes directories)
#ro-bind=${HOME}/.ipython

