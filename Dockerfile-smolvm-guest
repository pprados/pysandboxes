# smolvm provider, guest: the image of the microVM the sandboxed code runs in.
# Python and the runtime dependencies of pysandboxes; the package itself is mounted from the host at run time.
# Build: make build/smolvm-guest.tar  =>  a `docker save` archive that smolvm runs without a registry.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
    "fastapi>=0.115.0" \
    "uvicorn>=0.34.0" \
    "tblib>=3.1.0" \
    "aiohttp>=3.14.3" \
    "aiohttp-sse-client>=0.2.1" \
    "typing_extensions>=4.0.0"
