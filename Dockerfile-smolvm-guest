# smolvm provider, guest: the image of the microVM the sandboxed code runs in.
# Python and pysandboxes, installed from the wheel of the build: the guest runs it when the host's package sits where
# smolvm refuses to share it (/usr). A package smolvm can share (a checkout) is shared and wins over this copy.
# Build: make build/smolvm-guest.tar  =>  a `docker save` archive that smolvm runs without a registry.
FROM python:3.12-slim

ARG WHEEL
COPY dist/${WHEEL} /tmp/${WHEEL}
RUN pip install --no-cache-dir /tmp/${WHEEL} && rm /tmp/${WHEEL}
