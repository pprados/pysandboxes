# LiteLLM-style model id (Strands LiteLLMModel). Use provider/model or provider:model.
# Examples: openai/gpt-4o-mini, openai:gpt-4o-mini, anthropic/claude-3-5-sonnet-20241022
CHAT_MODEL=openai/gpt-4o-mini

# API keys — set the ones that match your CHAT_MODEL provider (LiteLLM reads standard env names).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Optional: override default tool task (must still require tools).
# AGENT_TASK=

# Optional: cap on model calls per run (same as --max-iterations).
# AGENT_MAX_ITERATIONS=12
