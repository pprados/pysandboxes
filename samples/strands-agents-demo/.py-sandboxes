# Profile for the PARTIAL mode: only the tool bodies enter the sandbox.
# The complete mode has its own profile, `.py-sandboxes-complete`, deliberately
# separate -- sharing one file would grant each mode the other's privileges for
# nothing, which is the opposite of what the partial mode is for. Relearn both
# with `learn.py`; see its docstring.
#
# The `net=` rule is not learned: which hosts a tool may reach is the author's
# decision, not an observation.
py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

net=ALLOW|TCP|www.google.com|443|OUT

# Add rules (2026/09/10 at 07:36)
env=CONDA_HOME=${CONDA_HOME}
env=HOME=${HOME}
env=LANGUAGE=${LANGUAGE}
env=PWD=${PWD}
env=PYDANTIC_DISABLE_PLUGINS=${PYDANTIC_DISABLE_PLUGINS}
env=PYENV_ROOT=${PYENV_ROOT}
env=PYTHONUSERBASE=${PYTHONUSERBASE}
env=TEMP=${TEMP}
env=TMP=${TMP}

# ⚠ Dangerous!
python-import=atexit, ctypes, importlib, inspect, mmap, subprocess

# Standard Python
python-import=__future__, _codecs_cn, _codecs_hk, _codecs_iso2022, _codecs_jp
python-import=_codecs_kr, _codecs_tw, _compression, _elementtree, _hashlib
python-import=_markupbase, _multibytecodec, _multiprocessing, _posixshmem, _queue
python-import=_sysconfigdata__linux_x86_64-linux-gnu, _thread, _zoneinfo, abc, array
python-import=ast, asyncio, base64, binascii, bisect, calendar, codecs, collections
python-import=colorsys, concurrent, configparser, contextlib, contextvars, copy
python-import=copyreg, dataclasses, datetime, decimal, email, encodings, enum, errno
python-import=fnmatch, fractions, functools, getpass, gettext, gzip, hashlib, heapq
python-import=hmac, html, http, io, ipaddress, itertools, json, keyword, locale
python-import=logging, math, mimetypes, multiprocessing, numbers, operator, os
python-import=pathlib, pickle, platform, posixpath, pprint, queue, random, re
python-import=reprlib, runpy, secrets, select, selectors, shlex, shutil, signal
python-import=socket, socketserver, ssl, stat, string, stringprep, struct, sysconfig
python-import=tempfile, termios, textwrap, threading, time, traceback, types, typing
python-import=unicodedata, urllib, uuid, weakref, xml, zipfile, zlib, zoneinfo

# External modules (Are you sure about the origin?)
python-import=81d243bd2c585b0f4821__mypyc
python-import=annotated_doc
python-import=annotated_types
python-import=anyio
python-import=attr
python-import=attrs
python-import=boto3
python-import=botocore
python-import=bs4
python-import=certifi
python-import=charset_normalizer
python-import=click
python-import=dateutil
python-import=docstring_parser
python-import=email_validator
python-import=fastapi
python-import=h11
python-import=httpcore
python-import=httpx
python-import=idna
python-import=importlib_metadata
python-import=jmespath
python-import=jsonschema
python-import=jsonschema_specifications
python-import=markdownify
python-import=opentelemetry
python-import=packaging
python-import=pydantic
python-import=pydantic_core
python-import=pyexpat
python-import=pygments
python-import=python_multipart
python-import=referencing
python-import=rich
python-import=rpds
python-import=s3transfer
python-import=six
python-import=sniffio
python-import=soupsieve
python-import=starlette
python-import=strands
python-import=strands_agents_demo
python-import=typing_extensions
python-import=typing_inspection
python-import=urllib3
python-import=uvicorn
python-import=watchdog
python-import=websockets
python-import=wrapt
python-import=yaml
python-import=zipp

# The repository root, which uv installs as an editable dependency (see
# `[tool.uv.sources]`), so the sandbox must be able to read it. Relative to the
# working directory, which is this sample's own directory: an absolute `~/...`
# form only resolves on a machine that checked the repository out there, and
# fails on any CI runner. Learning mode cannot emit this form -- it never walks
# above PWD -- so `make learn` puts the absolute path back.
expose-ro=../..

net=ALLOW|TCP|ip6-localhost|0|IN
net=ALLOW|TCP|ip6-loopback|0|IN

# ⚠ native: native code and arbitrary memory access
python-api=ALLOW:ctypes.CDLL

# Add rules (2026/09/10 at 10:06)
env=PSUTIL_DEBUG=${PSUTIL_DEBUG}
env=VIRTUAL_ENV=${VIRTUAL_ENV}

# Standard Python
python-import=_decimal, _socket, glob, pwd, resource

# External modules (Are you sure about the origin?)
python-import=psutil


# The calculator tool evaluates a string the model produced. `closed` rather
# than the adaptive default: the caller already passes {"__builtins__": {}},
# so the resulting namespace is identical, and a profile handling model output
# should declare its surface here rather than at the call site.
eval-namespace=closed
eval-syntax=arith, compare
eval-max-iterations=100_000
eval-timeout=2s
