# Copy to .env and fill in values for your provider.

# Chat model: provider/model or provider:model (CrewAI / LiteLLM — both separators OK)
CHAT_MODEL=openai/gpt-4o-mini

# Optional: override the default user task (should still require tools)
# AGENT_TASK=

# Optional: cap agent iterations (also --max-iterations)
# AGENT_MAX_ITER=12

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google AI Studio / Gemini (crewai extra google-genai)
# GOOGLE_API_KEY=

# AWS (Bedrock / crewai extras aws or bedrock)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Azure AI Inference (crewai extra azure-ai-inference)
# AZURE_API_KEY=
# AZURE_API_BASE=

# LiteLLM-routed providers: set the key for the provider you use (see LiteLLM docs)
