# Profile for the PARTIAL mode: only the tool bodies enter the sandbox.
# The complete mode has its own profile, `.py-sandboxes-complete`, deliberately
# separate -- sharing one file would grant each mode the other's privileges for
# nothing, which is the opposite of what the partial mode is for. Relearn both
# with `learn.py`; see its docstring.
#
# The `net=` rule is not learned: which hosts a tool may reach is the author's
# decision, not an observation.
py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

net=ALLOW|TCP|www.google.com|443|OUT

# Add rules (2026/09/10 at 07:17)
env=*_API_KEY=${*_API_KEY}
env=*_TOKEN=${*_TOKEN}
env=*_BASE_URL=${*_BASE_URL}
env=n_examples=${n_examples}
env=n_load=${n_load}

# ⚠ Dangerous!
python-import=atexit, ctypes, importlib, inspect, mmap, pkgutil, subprocess
python-import=webbrowser

# Standard Python
python-import=__future__, _cffi_backend, _codecs_cn, _codecs_hk, _codecs_iso2022
python-import=_codecs_jp, _codecs_kr, _codecs_tw, _compression, _elementtree
python-import=_csv, _decimal, _hashlib, _markupbase, _multibytecodec, _multiprocessing, _queue, _socket
python-import=_sqlite3, _string, _sysconfigdata__linux_x86_64-linux-gnu, _thread
python-import=_zoneinfo, abc, argparse, array, ast, asyncio, base64, binascii
python-import=bisect, calendar, codecs, collections, colorsys, concurrent
python-import=configparser, contextlib, contextvars, copy, copyreg, csv, dataclasses
