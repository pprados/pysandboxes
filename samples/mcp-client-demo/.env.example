MY_IP=<your ip>  # hostname -I | awk '{print $1}'

# OpenAI-compatible chat: provider/model (see mcp_simple_chatbot/provider_registry.py)
# export CHAT_MODEL=openai/gpt-4o-mini
CHAT_MODEL=xai/grok-4-fast-non-reasoning

# API key for the provider above (OpenAI, xAI, Groq, etc.)
API_KEY=your_api_key_here

# Optional: custom SQLite path for provider base URLs (default: package dir provider_urls.sqlite)
# CHAT_PROVIDER_URLS_DB=/path/to/provider_urls.sqlite
