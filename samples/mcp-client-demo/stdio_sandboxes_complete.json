{
  "mcpServers": {
  // Version with `python-sb`. The user MCP client decide the rules
  //  to use (complete mode) in `../mcp-server-demo/mcp_server/.py-sandboxes-complete`,
  //  a profile learned in the complete mode and used only there
    "mcp_server": {
      "cwd": "../mcp-server-demo",
      "command": "python",
      "args": [
        "-m", "pysandboxes.python_sb",
        "--pysandboxes-config=mcp_server/.py-sandboxes-complete",
//        "--learn=mcp_server/.py-sandboxes-complete",
        "-m", "mcp_server.main",
        "-t", "stdio"
      ],
      "env": {
         "OS_SANDBOX": "subprocess"
      }
    }
 }
}
