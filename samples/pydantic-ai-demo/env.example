# Copy to .env and fill in values for your provider.

# Chat model: provider:model_id or provider/model (normalized to colon; see README)
CHAT_MODEL=openai:gpt-4o-mini

# Optional: override the default user task (should still require tools)
# AGENT_TASK=

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google AI Studio / Gemini (often google-gla:… in Pydantic AI)
# GOOGLE_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# Groq
# GROQ_API_KEY=

# Cohere
# COHERE_API_KEY=

# AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Vertex AI (google extra / vertexai — see Pydantic AI docs)
# GOOGLE_APPLICATION_CREDENTIALS=
