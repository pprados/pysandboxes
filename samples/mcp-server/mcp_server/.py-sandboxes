#include "./.local.py-sandboxes"  # May be add to .gitignore

#learn=./.local.py-sandboxes

#### OS-LEVEL SANDBOX PROVIDERS ####
os-sandbox=${OS_SANDBOX:-subprocess}

#### ENVIRONMENT VARIABLES ####
#env=HOME=${HOME}
env=LANGUAGE=${LANGUAGE}

#### FILE SYSTEM ACCESS ####
ignore=.secret
ro-bind=./resources,./resources

#### NETWORK ACCESS CONTROL ####
net=ALLOW|TCP|*|8000|IN
net=ALLOW|TCP|www.google.com|80|OUT

#### PYTHON IMPORTS CONTROL ####
# Standard Python
python-import=_cffi_backend, _decimal, _markupbase, _multibytecodec
python-import=_sysconfigdata__linux_x86_64-linux-gnu, _zoneinfo, _pydecimal, colorsys, decimal
python-import=concurrent, encodings, fractions, getpass, hmac, html, http, importlib, mmap, numbers, pprint, secrets
python-import=sysconfig, termios, webbrowser, zoneinfo

# External modules
python-import=aiofiles
python-import=annotated_types
python-import=anyio
python-import=arrow
python-import=attrs
python-import=authlib
python-import=bs4
python-import=charset_normalizer
python-import=cryptography
python-import=dateutil
python-import=dotenv
python-import=email_validator
python-import=exceptiongroup
python-import=fastapi
python-import=fastmcp
python-import=fqdn
python-import=h11
python-import=httpx
python-import=httpx_file
python-import=httpx_sse
python-import=isoduration
python-import=jsonpointer
python-import=jsonschema
python-import=jsonschema_specifications
python-import=lark
python-import=markdownify
python-import=mcp
python-import=mcp_server
python-import=pydantic
python-import=pydantic_core
python-import=pydantic_settings
python-import=pygments
python-import=python_multipart
python-import=referencing
python-import=rfc3339_validator
python-import=rfc3986_validator
python-import=rfc3987_syntax
python-import=rich
python-import=rpds
python-import=six
python-import=sniffio
python-import=soupsieve
python-import=sse_starlette
python-import=starlette
python-import=stringprep
python-import=typing_extensions
python-import=typing_inspection
python-import=uri_template
python-import=uvicorn
python-import=webcolors
python-import=* # FIXME
