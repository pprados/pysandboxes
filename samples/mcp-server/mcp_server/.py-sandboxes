# Accept to include working directories rules?
include "./py-sandboxes"
include "./.local.py-sandboxes"


os-sandbox=${OS_SANDBOX:-subprocess}

# Standard Python
python-import=__future__, _bisect, _blake2, _bz2, _collections_abc, _colorize
python-import=_compat_pickle, _compression, _contextvars, _datetime, _decimal
python-import=_hashlib, _heapq, _json, _lzma, _multiprocessing, _opcode
python-import=_opcode_metadata, _pickle, _queue, _random, _socket, _ssl, _struct
python-import=_sysconfigdata__linux_x86_64-linux-gnu, _uuid, _weakrefset, _zoneinfo
python-import=abc, argparse, array, ast, base64, binascii, bisect, bz2, calendar
python-import=collections, configparser, contextlib, contextvars, copy, copyreg
python-import=dataclasses, datetime, decimal, dis, email, encodings, enum, fnmatch
python-import=fractions, functools, genericpath, gettext, hashlib, heapq, hmac, html
python-import=http, inspect, io, ipaddress, json, keyword, linecache, locale, lzma
python-import=math, mimetypes, multiprocessing, numbers, operator, os, pickle
python-import=platform, posixpath, pprint, queue, quopri, random, re, reprlib, runpy
python-import=secrets, select, selectors, shlex, shutil, signal, socket, ssl, stat
python-import=string, struct, sysconfig, tempfile, textwrap, threading, token
python-import=tokenize, traceback, types, typing, unicodedata, urllib, uuid, weakref
python-import=zipfile, zlib, zoneinfo

# External modules (Are you sure about the origin?)
python-import=annotated_types
