ignore=.*
ro-bind=./resources,./resources
ro-bind=./.venv,./.venv  # FIXME

#net=ALLOW|TCP|0.0.0.0|8000|IN
#net=ALLOW|TCP|127.0.0.1|8000|IN
net=ALLOW|TCP|0.0.0.0|8000|IN
net=ALLOW|TCP|www.google.com|80|OUT