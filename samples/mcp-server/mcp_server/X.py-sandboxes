include "./.local.py-sandboxes"  # May be add to .gitignore

os-sandbox=${OS_SANDBOX:-subprocess}

env=HOME=${HOME}

# Standard Python
python-import=__future__, _cffi_backend, _collections_abc, _colorize, _compat_pickle
python-import=_compression, _decimal, _markupbase, _multibytecodec, _opcode_metadata
python-import=_sysconfigdata__linux_x86_64-linux-gnu, _weakrefset, _zoneinfo, abc
python-import=argparse, ast, base64, bisect, bz2, calendar, collections, colorsys
python-import=concurrent, configparser, contextlib, contextvars, copy, copyreg
python-import=dataclasses, datetime, decimal, dis, email, encodings, enum, fnmatch
python-import=fractions, functools, genericpath, getpass, gettext, glob, hashlib
python-import=heapq, hmac, html, http, importlib, inspect, io, ipaddress, json
python-import=keyword, linecache, locale, lzma, mimetypes, mmap, multiprocessing
python-import=ntpath, numbers, operator, os, pathlib, pickle, platform, posixpath
python-import=pprint, queue, quopri, random, re, reprlib, runpy, secrets, selectors
python-import=shlex, shutil, signal, socket, ssl, stat, string, struct, sysconfig
python-import=tempfile, termios, textwrap, threading, token, tokenize, traceback
python-import=types, typing, urllib, uuid, weakref, webbrowser, zipfile, zoneinfo

# External modules (Are you sure about the origin?)
python-import=annotated_types
python-import=anyio
python-import=attr
python-import=attrs
python-import=authlib
python-import=bs4
python-import=certifi
python-import=charset_normalizer
python-import=click
python-import=cryptography
python-import=dotenv
python-import=exceptiongroup
python-import=fastmcp
python-import=h11
python-import=httpcore
python-import=httpx
python-import=httpx_sse
python-import=idna
python-import=jsonschema
python-import=jsonschema_specifications
python-import=markdownify
python-import=mcp
python-import=mcp_server
python-import=opcode
python-import=pydantic
python-import=pydantic_core
python-import=pydantic_settings
python-import=pygments
python-import=python_multipart
python-import=referencing
python-import=rfc3339_validator
python-import=rich
python-import=rpds
python-import=six
python-import=sniffio
python-import=soupsieve
python-import=sse_starlette
python-import=starlette
python-import=typing_extensions
python-import=typing_inspection
python-import=uvicorn

ignore=.*
ro-bind=./resources,./resources