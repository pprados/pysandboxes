# Copy to .env and fill in values for your provider.

# Chat model: LiteLLM form provider/model, or provider:model (normalized to slash; see README)
CHAT_MODEL=openai/gpt-4o-mini

# Optional: override the default user task (should still require tools)
# AGENT_TASK=

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google AI Studio / Gemini (LiteLLM)
# GOOGLE_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# Groq
# GROQ_API_KEY=

# Cohere
# COHERE_API_KEY=

# AWS (Bedrock via LiteLLM)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
