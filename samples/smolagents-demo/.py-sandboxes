env=HF_ASSETS_CACHE=${HF_ASSETS_CACHE}
env=HF_ENDPOINT=${HF_ENDPOINT}
env=HF_HOME=${HF_HOME}
env=HF_HUB_CACHE=${HF_HUB_CACHE}
env=HF_HUB_VERBOSITY=${HF_HUB_VERBOSITY}
env=HF_TOKEN_PATH=${HF_TOKEN_PATH}
env=HF_XET_CACHE=${HF_XET_CACHE}
env=HOME=${HOME}
env=HUGGINGFACE_ASSETS_CACHE=${HUGGINGFACE_ASSETS_CACHE}
env=HUGGINGFACE_HUB_CACHE=${HUGGINGFACE_HUB_CACHE}
env=PWD=${PWD}
env=PYDANTIC_DISABLE_PLUGINS=${PYDANTIC_DISABLE_PLUGINS}
env=PYTHON_DOTENV_DISABLED=${PYTHON_DOTENV_DISABLED}
env=VIRTUAL_ENV=${VIRTUAL_ENV}
env=XDG_CACHE_HOME=${XDG_CACHE_HOME}

