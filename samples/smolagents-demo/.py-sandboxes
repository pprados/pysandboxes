# Profile for the PARTIAL mode: only the tool bodies enter the sandbox.
# The complete mode has its own profile, `.py-sandboxes-complete`, deliberately
# separate -- sharing one file would grant each mode the other's privileges for
# nothing, which is the opposite of what the partial mode is for. Relearn both
# with `learn.py`; see its docstring.
#
# The `net=` rule is not learned: which hosts a tool may reach is the author's
# decision, not an observation.
py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

net=ALLOW|TCP|www.google.com|443|OUT

# Add rules (2026/09/10 at 07:34)
env=*_API_KEY=${*_API_KEY}
env=*_TOKEN=${*_TOKEN}
env=*_BASE_URL=${*_BASE_URL}
env=n_examples=${n_examples}
env=n_load=${n_load}

# ⚠ Dangerous!
python-import=atexit, importlib, inspect, mmap, subprocess

# Standard Python
python-import=__future__, _codecs_cn, _codecs_hk, _codecs_iso2022, _codecs_jp
python-import=_codecs_kr, _codecs_tw, _hashlib, _markupbase, _multibytecodec
python-import=_multiprocessing, _queue, _sqlite3
python-import=_sysconfigdata__linux_x86_64-linux-gnu, _zoneinfo, abc, argparse
python-import=array, ast, asyncio, base64, binascii, bisect, calendar, codecs
python-import=collections, colorsys, concurrent, configparser, contextlib
python-import=contextvars, copy, copyreg, dataclasses, datetime, decimal, difflib
python-import=email, encodings, enum, errno, fcntl, fnmatch, fractions, functools
python-import=getpass, gettext, hashlib, heapq, hmac, html, http, io, ipaddress
python-import=itertools, json, keyword, locale, logging, marshal, math, mimetypes
python-import=multiprocessing, numbers, operator, os, pathlib, pickle, platform
python-import=posixpath, queue, random, re, reprlib, secrets, select, selectors
python-import=shlex, shutil, signal, socket, socketserver, sqlite3, ssl, stat
python-import=string, stringprep, struct, sysconfig, tempfile, termios, textwrap
python-import=threading, time, traceback, types, typing, unicodedata, urllib, uuid
python-import=weakref, zipfile, zipimport, zlib, zoneinfo

# External modules (Are you sure about the origin?)
python-import=81d243bd2c585b0f4821__mypyc
python-import=PIL
python-import=annotated_doc
python-import=annotated_types
python-import=anyio
python-import=attr
python-import=bs4
python-import=certifi
python-import=charset_normalizer
python-import=click
python-import=dotenv
python-import=email_validator
python-import=fastapi
python-import=filelock
python-import=h11
python-import=httpcore
python-import=httpx
python-import=huggingface_hub
python-import=idna
python-import=jinja2
python-import=markdown_it
python-import=markdownify
python-import=markupsafe
python-import=mdurl
python-import=pydantic
python-import=pydantic_core
python-import=pygments
python-import=requests
python-import=rich
python-import=six
python-import=smolagents
python-import=smolagents_demo
python-import=sniffio
python-import=soupsieve
python-import=starlette
python-import=tqdm
python-import=typing_extensions
python-import=typing_inspection
python-import=urllib3
python-import=uvicorn
python-import=yaml

expose-ro=~/workspace/pysandboxes

net=ALLOW|TCP|ip6-localhost|0|IN
net=ALLOW|TCP|ip6-loopback|0|IN

# Add rules (2026/09/10 at 10:02)
env=VIRTUAL_ENV=${VIRTUAL_ENV}

# ⚠ Dangerous!
python-import=ctypes

# Standard Python
python-import=_decimal, _socket, tty


expose-ro=/proc/sys/kernel/random
expose-rw=${TMP}

# introspection: can be used to undo the patches
# filelock (pulled by huggingface-hub) installs an audit hook to detect unsafe
# forks. Granted as the named function, never as the whole category.
python-api=ALLOW:sys.addaudithook

# The calculator tool evaluates a string the model produced. `closed` rather
# than the adaptive default: the caller already passes {"__builtins__": {}},
# so the resulting namespace is identical, and a profile handling model output
# should declare its surface here rather than at the call site.
eval-namespace=closed
eval-syntax=arith, compare
eval-max-iterations=100_000
eval-timeout=2s
