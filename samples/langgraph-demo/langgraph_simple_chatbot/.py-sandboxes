#learn=.py-sandboxes
py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

env=PYTHONUSERBASE=${PYTHONUSERBASE}

# ⚠ Dangerous!
python-import=subprocess

# Standard Python
python-import=__future__, _decimal, _hashlib, _io, _socket
python-import=_sysconfigdata__linux_x86_64-linux-gnu, _zoneinfo, abc, array, ast
python-import=asyncio, base64, binascii, collections, colorsys, concurrent
python-import=contextlib, contextvars, copy, copyreg, dataclasses, datetime, decimal
python-import=email, enum, errno, fractions, functools, hashlib, hmac, html, http
python-import=importlib, inspect, io, ipaddress, itertools, json, keyword, logging
python-import=math, mimetypes, numbers, operator, os, pathlib, pickle, queue, random
python-import=re, secrets, shlex, shutil, signal, socket, ssl, stat, struct
python-import=sysconfig, tempfile, textwrap, threading, time, traceback, types
python-import=typing, unicodedata, urllib, uuid, weakref, zoneinfo

# External modules (Are you sure about the origin?)
python-import=annotated_doc
python-import=annotated_types
python-import=anyio
python-import=email_validator
python-import=fastapi
python-import=h11
python-import=idna
python-import=orjson
python-import=pydantic
python-import=pydantic_core
python-import=python_multipart
python-import=sniffio
python-import=starlette
python-import=typing_extensions
python-import=typing_inspection
python-import=uvicorn

expose-ro=.

net=ALLOW|TCP|0.0.0.0/32|52693|IN
