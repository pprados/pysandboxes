# Copy to .env and fill in values for your provider.

# Chat model: provider:model_id or provider/model (normalized to : for LangChain; see README)
CHAT_MODEL=openai:gpt-4o-mini

# Optional: override the default user task (should still require tools)
# AGENT_TASK=

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google AI Studio / Gemini
# GOOGLE_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# Groq (official env name is GROQ_API_KEY — not GROK_API_KEY)
# GROQ_API_KEY=

# Cohere
# COHERE_API_KEY=

# AWS Bedrock (when using langchain-aws)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Vertex AI (when using langchain-google-vertexai)
# GOOGLE_APPLICATION_CREDENTIALS=
