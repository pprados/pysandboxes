# Copy to .env and fill in values for your provider.

# Chat model: see README (bare OpenAI id, openai:…, litellm:…, or provider/model for LiteLLM)
CHAT_MODEL=gpt-4o-mini

# Optional: override the default user task (should still require tools)
# AGENT_TASK=

# Optional: cap agent turns (Runner max_turns)
# AGENT_MAX_TURNS=12

# OpenAI (default provider for bare model names)
# OPENAI_API_KEY=

# LiteLLM / other providers — set the keys your route needs (examples)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
