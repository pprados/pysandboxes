# Chat model for Agno: provider:model_id (Agno native form). You may also use provider/model;
# the demo normalizes a single slash to the first colon.
# Examples:
#   CHAT_MODEL=openai:gpt-4o-mini
#   CHAT_MODEL=anthropic/claude-sonnet-4-20250514
#   CHAT_MODEL=google/gemini-2.0-flash
#   CHAT_MODEL=litellm/openai/gpt-4o-mini
#
# API keys (set the ones matching your provider):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=
# MISTRAL_API_KEY=
# AWS_ACCESS_KEY_ID=  (and AWS_SECRET_ACCESS_KEY, AWS_REGION for Bedrock)
# FIREWORKS_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# OLLAMA_HOST=  (optional; default local)
# HF_TOKEN=  (Hugging Face)

CHAT_MODEL=openai:gpt-4o-mini

# Optional: override default task or tool-call budget
# AGENT_TASK=
# AGENT_MAX_TOOL_CALLS=32
