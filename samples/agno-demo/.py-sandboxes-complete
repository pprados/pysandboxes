# Profile for the COMPLETE mode: the whole agent runs under `python-sb`, so this
# profile has to allow the framework's own dispatch too. The partial mode has its
# own profile, `.py-sandboxes`, deliberately separate. Relearn both with
# `learn.py`; see its docstring.
py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

net=ALLOW|TCP|www.google.com|443|OUT

