# Sandbox configuration for google-adk-demo
# This file configures security rules for the fetch_webpage sandbox
#learn=.py-sandboxes

py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

env=PYTHONUSERBASE=${PYTHONUSERBASE}

# ⚠ Dangerous!
python-import=subprocess

# Standard Python library imports
python-import=__future__, _decimal, _hashlib, _io, _socket
python-import=_sysconfigdata__linux_x86_64-linux-gnu, _zoneinfo, abc, array, ast
python-import=asyncio, base64, binascii, collections, colorsys, concurrent
python-import=contextlib, contextvars, copy, copyreg, dataclasses, datetime, decimal
python-import=email, enum, errno, fractions, functools, hashlib, hmac, html, http
python-import=importlib, inspect, io, ipaddress, itertools, json, keyword, logging
python-import=marshal, math, mimetypes, numbers, operator, os, pathlib, pickle, queue, random
python-import=re, secrets, select, shlex, shutil, signal, socket, ssl, stat, struct
python-import=sysconfig, tempfile, textwrap, threading, time, tokenize, traceback, types
python-import=typing, unicodedata, urllib, uuid, weakref, zoneinfo

# External modules for HTTP and sandbox infrastructure
python-import=h11
python-import=httpcore
python-import=httpx
python-import=idna
python-import=sniffio
python-import=starlette
python-import=uvicorn

# Allow example.com only, deny all other domains
net=ALLOW|TCP|example.com|80|OUT
net=ALLOW|TCP|example.com|443|OUT

expose-ro=.
