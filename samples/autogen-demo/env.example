# Copy to .env and fill in keys for your provider.

# Chat model: provider:model_id or provider/model_id
CHAT_MODEL=openai:gpt-4o-mini

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google Gemini (OpenAI-compatible API)
# GOOGLE_API_KEY=

# Optional: default user task (must require tools)
# AGENT_TASK=

# Cap on tool-calling rounds inside AssistantAgent
# AGENT_MAX_TOOL_ITERATIONS=12
