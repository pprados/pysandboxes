# Profile for the COMPLETE mode: the whole process runs under `python-sb`, so
# this profile has to allow the framework's own dispatch too. The partial mode
# has its own profile, `.py-sandboxes`, deliberately separate. Relearn both with
# `learn.py`; see its docstring.
py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

net=ALLOW|TCP|www.google.com|443|OUT

# Add rules (2026/09/10 at 07:13)
env=CONDA_HOME=${CONDA_HOME}
env=HOME=${HOME}
env=PWD=${PWD}
env=PYENV_ROOT=${PYENV_ROOT}
env=TEMP=${TEMP}
env=TMP=${TMP}

# ⚠ Dangerous!
python-import=atexit, importlib, inspect, subprocess

# Standard Python
python-import=__future__, _codecs_cn, _codecs_hk, _codecs_iso2022, _codecs_jp
python-import=_codecs_kr, _codecs_tw, _markupbase, _multibytecodec, _queue, _socket
python-import=abc, array, asyncio, base64, bisect, calendar, codecs, collections
python-import=concurrent, contextlib, contextvars, copy, copyreg, dataclasses
python-import=datetime, email, encodings, enum, errno, fnmatch, functools, gettext
python-import=hashlib, heapq, html, http, io, ipaddress, itertools, json, keyword
python-import=logging, math, mimetypes, operator, os, pathlib, queue, re, reprlib
python-import=select, signal, socket, ssl, stat, stringprep, struct, tempfile
python-import=textwrap, threading, time, types, typing, unicodedata, urllib, uuid
python-import=weakref, zipfile, zlib

# External modules (Are you sure about the origin?)
python-import=81d243bd2c585b0f4821__mypyc
python-import=anyio
python-import=autogen_demo
python-import=bs4
python-import=certifi
python-import=charset_normalizer
python-import=click
python-import=h11
python-import=httpcore
python-import=httpx
python-import=idna
python-import=markdownify
python-import=pygments
python-import=six
python-import=sniffio
python-import=soupsieve
python-import=typing_extensions

expose-ro=.

# threads: concurrency primitives
python-api=ALLOW:threading.Thread.start
python-api=ALLOW:threading._start_joinable_thread

# The calculator tool evaluates a string the model produced. `closed` rather
# than the adaptive default: the caller already passes {"__builtins__": {}},
# so the resulting namespace is identical, and a profile handling model output
# should declare its surface here rather than at the call site.
eval-namespace=closed
eval-syntax=arith, compare
eval-max-iterations=100_000
eval-timeout=2s
