{
  "mcpServers": {
    // The MCP-server decide the portion of code to isolate (selected mode).
    // The confugration is in `../mcp-server/mcp_server/.py-sandboxes`
    "mcp_server": {
      "type": "stdio",
      "cwd": "../mcp-server",
      "command": "python",
      "args": [
        "-m", "mcp_server.main",
//        "--learn=mcp_server/.py-sandboxes",
        "-t", "stdio",
        "--sandbox-port", "48000"  // Force a port to communicate with the sandbox, and add it in .py-sandboxes
      ],
      "env": {
        "OS_SANDBOX": "subprocess"
      }
    }
  }
}
