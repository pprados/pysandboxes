{
  "mcpServers": {
    "mcp_server": {
      "cwd": "../mcp-server",
      "command": "python",
      "args": [
        "-m", "pysandboxes.python_sb",
//        "--learn=.py-sandboxes",
        "-m", "mcp_server.main",
        "-t", "stdio"
      ],
      "env": {
        "OS_SANDBOX": "None",
        "PY_SANDBOX": "None"
      }
    }
 }
}
