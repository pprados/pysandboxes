{
  "mcpServers": {
  // Version without `python-sb`. The user MCP client decide the rules to use
    "mcp_server": {
      "cwd": "../mcp-server",
      "command": "python","cwd": "../mcp-server",
      "args": [
        "-m", "pysandboxes.python_sb",
        "--os-sandbox=none",
        "--py-sandbox=none",
//        "--learn=.py-sandboxesXX",
        "-m", "mcp_server.main",
        "-t", "stdio"
      ]
    }
 }
}