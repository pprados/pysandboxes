firejail.net=br0

include ".py-sandboxes.pycharm"
# include "./.local.py-sandboxes"  # May be add to .gitignore
py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

env=GROK_API_KEY=${GROK_API_KEY}
env=HOME=${HOME}
env=LANGUAGE=${LANGUAGE}
env=LOGNAME=${LOGNAME}
env=PATH=${PATH}
env=PYTHONUSERBASE=${PYTHONUSERBASE}
env=SHELL=${SHELL}
env=USER=${USER}
env=MY_IP=${MY_IP}

# ⚠ Dangerous!
python-import=subprocess

# Standard Python
python-import=_cffi_backend, _decimal, _sysconfigdata__linux_x86_64-linux-gnu
python-import=_zoneinfo, argparse, ast, asyncio, base64, bisect, bz2, calendar
python-import=collections, colorsys, configparser, contextlib, contextvars, copy
python-import=copyreg, dataclasses, datetime, decimal, dis, email, encodings, enum
python-import=fnmatch, fractions, functools, genericpath, getpass, gettext, glob
python-import=hashlib, heapq, hmac, html, http, importlib, inspect, io, ipaddress
python-import=json, keyword, linecache, locale, logging, lzma, mimetypes, mmap
python-import=multiprocessing, ntpath, numbers, operator, os, pathlib, pickle
python-import=pkgutil, platform, posixpath, pprint, queue, quopri, random, re
python-import=reprlib, runpy, secrets, selectors, shlex, shutil, signal, socket
python-import=socketserver, ssl, stat, string, stringprep, struct, sysconfig
python-import=tempfile, termios, textwrap, threading, token, tokenize, traceback
python-import=types, typing, urllib, uuid, warnings, weakref, webbrowser, zipfile
python-import=zipimport, zoneinfo

# External modules (Are you sure about the origin?)
python-import=annotated_types
python-import=anyio
python-import=arrow
python-import=attr
python-import=attrs
python-import=authlib
python-import=certifi
python-import=click
python-import=cryptography
python-import=dateutil
python-import=dotenv
python-import=exceptiongroup
python-import=fastmcp
python-import=fqdn
python-import=h11
python-import=httpcore
python-import=httpx
python-import=httpx_sse
python-import=idna
python-import=isoduration
python-import=jsonc
python-import=jsonpointer
python-import=jsonschema
python-import=jsonschema_specifications
python-import=lark
python-import=mcp
python-import=mcp_simple_chatbot
python-import=opcode
python-import=pydantic
python-import=pydantic_core
python-import=pydantic_settings
python-import=pygments
python-import=python_multipart
python-import=referencing
python-import=rfc3339_validator
python-import=rfc3986_validator
python-import=rfc3987_syntax
python-import=rich
python-import=rpds
python-import=six
python-import=sniffio
python-import=sse_starlette
python-import=starlette
python-import=typing_extensions
python-import=typing_inspection
python-import=uri_template
python-import=uvicorn
python-import=webcolors
ro-bind=.,.

net=ALLOW|TCP|api.groq.com|443|OUT      # For LLM model
net=ALLOW|TCP|${MY_IP:-127.0.0.1}|8000|OUT  # For communicate with the local MCP server
#net=ALLOW|TCP|*|8000|*
net=ALLOW|TCP|www.google.com|80|OUT    # For MCP server with stdio protocol
net=ALLOW|TCP|127.0.0.1|48000|*        # For communication between application and partial sandbox
net=ALLOW|TCP|*|*|*   # FIXME

