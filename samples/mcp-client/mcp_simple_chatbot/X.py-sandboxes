include ".py-sandboxes.pycharm"
include "./.local.py-sandboxes"  # May be add to .gitignore
py-sandbox=true
os-sandbox=${OS_SANDBOX:-subprocess}

env=GROK_API_KEY=${GROK_API_KEY}
env=HOME=${HOME}
env=LANGUAGE=${LANGUAGE}
env=LOGNAME=${LOGNAME}
env=PATH=${PATH}
env=PYTHONUSERBASE=${PYTHONUSERBASE}
env=SHELL=${SHELL}
env=USER=${USER}

# Standard Python
python-import=__future__, _cffi_backend, _collections_abc, _colorize, _compat_pickle
python-import=_compression, _decimal, _opcode_metadata
python-import=_sysconfigdata__linux_x86_64-linux-gnu, _weakrefset, _zoneinfo, abc
python-import=argparse, ast, base64, bisect, bz2, calendar, collections, colorsys
python-import=configparser, contextlib, contextvars, copy, copyreg, dataclasses
python-import=datetime, decimal, dis, email, encodings, enum, fnmatch, fractions
python-import=functools, genericpath, getpass, gettext, hashlib, heapq, hmac, html
python-import=http, importlib, inspect, io, ipaddress, json, keyword, linecache
python-import=locale, lzma, mimetypes, mmap, multiprocessing, numbers, operator, os
python-import=pickle, platform, posixpath, pprint, queue, quopri, random, re
python-import=reprlib, runpy, secrets, selectors, shlex, shutil, signal, socket, ssl
python-import=stat, string, stringprep, struct, sysconfig, tempfile, termios
python-import=textwrap, threading, token, tokenize, traceback, types, typing, urllib
python-import=uuid, weakref, webbrowser, zipfile, zoneinfo

# External modules (Are you sure about the origin?)
python-import=annotated_types
python-import=anyio
python-import=attr
python-import=attrs
python-import=authlib
python-import=certifi
python-import=click
python-import=cryptography
python-import=dotenv
python-import=exceptiongroup
python-import=fastmcp
python-import=h11
python-import=httpcore
python-import=httpx
python-import=httpx_sse
python-import=idna
python-import=jsonc
python-import=jsonschema
python-import=jsonschema_specifications
python-import=mcp
python-import=mcp_simple_chatbot
python-import=opcode
python-import=pydantic
python-import=pydantic_core
python-import=pydantic_settings
python-import=pygments
python-import=python_multipart
python-import=referencing
python-import=rfc3339_validator
python-import=rich
python-import=rpds
python-import=six
python-import=sniffio
python-import=sse_starlette
python-import=starlette
python-import=typing_extensions
python-import=typing_inspection
python-import=uvicorn

ro-bind=.,.

net=ALLOW|UDP|api.groq.com|443|OUT # For LLM model
net=ALLOW|TCP|localhost|8000|OUT  # For local MCP server
